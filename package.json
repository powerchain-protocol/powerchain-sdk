{
  "name": "powerchain",
  "version": "1.0.0-beta.1",
  "private": true,
  "description": "PowerChain Monorepo",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/powerchain-protocol/powerchain.git"
  },
  "homepage": "https://github.com/powerchain-protocol/powerchain",
  "bugs": {
    "url": "https://github.com/powerchain-protocol/powerchain/issues"
  },
  "keywords": [
    "powerchain",
    "web3",
    "blockchain",
    "solana",
    "typescript",
    "javascript",
    "sdk",
    "wallet",
    "payments",
    "treasury",
    "exchange",
    "renewable-energy",
    "ai",
    "supabase",
    "nextjs",
    "vercel-ai"
  ],
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "clean": "turbo clean && rimraf node_modules .turbo",

    "lint": "turbo lint",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "biome check .",

    "typecheck": "turbo typecheck",

    "test": "turbo test",
    "test:watch": "turbo test --watch",
    "coverage": "turbo coverage",

    "bootstrap": "node scripts/bootstrap-packages.mjs",

    "docs": "turbo docs",

    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",

    "prepare": "husky",

    "preinstall": "npx only-allow pnpm"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.6",
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.6",
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "husky": "^9.1.7",
    "only-allow": "^1.2.1",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}